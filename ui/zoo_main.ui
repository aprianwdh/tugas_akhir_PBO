  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background-color: #0F1117;
    color: #F1F5F9;
    font-family: 'Segoe UI', 'SF Pro Display', Arial, sans-serif;
}
QScrollArea {
    border: none;
    background: transparent;
}
QScrollBar:vertical {
    background: #1A1D2E;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #2D3154;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #6C63FF;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background: #232640;
    color: #F1F5F9;
    border: 1.5px solid #2D3154;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #6C63FF;
}
QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border-color: #6C63FF;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #94A3B8;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #232640;
    color: #F1F5F9;
    border: 1.5px solid #2D3154;
    border-radius: 8px;
    selection-background-color: #6C63FF;
    padding: 4px;
}
QLabel {
    background: transparent;
}
QMessageBox {
    background: #1A1D2E;
    color: #F1F5F9;
}
QMessageBox QPushButton {
    background: #6C63FF;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 6px 18px;
    font-weight: 600;
}</string>
